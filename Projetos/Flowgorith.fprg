<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="calculadora_em_flowgorithm"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-26 04:00:55 "/>
        <attribute name="created" value="dXNlcjtERVNLVE9QLUdTNklCQVE7MjAyNi0wOC0yMjsiMDM6MDA6MTUgIjsyNzA5"/>
        <attribute name="edited" value="dXNlcjtERVNLVE9QLUdTNklCQVE7MjAyNi0wOC0yNjsiMDQ6MDA6NTUgIjs2OzI4MzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <output expression="&quot;MENU CALCULADORA&quot; &#13;&#10;&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot; &#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;1- Soma(+)  |  2- Subtra&#231;&#227;o(-)  |  3- Multiplica&#231;&#227;o(X)  |  4- Divis&#227;o(&#247;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;5- Pot&#234;ncia&#231;&#227;o(B&#7497;)  |  6- Raiz quadrada(&#8730;)  |  7- Fatoria(X!)  |  8- Raiz c&#250;bica(&#8731;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;9- Logaritmo(log10)  |  10- Seno(Sen)  |  11- Cosseno(Cos)  |  12- Tangente(Tan) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;13- Arredondamento(&#8776;) | 14- MMC | 15- MDC | 16- Porcentagem(%) &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;17- Convers&#227;o de &#226;ngulos(rad ou &#176;)  |  18- PI(&#960;)  |  19- Euler(e) | 20- Valor absoluto &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot; &#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;Escolha uma op&#231;&#227;o (1-20): &quot;" newline="True"/>
            <declare name="M" type="String" array="False" size=""/>
            <assign variable="M" expression="&quot;MENU CALCULADORA&quot; &#13;&#10;&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot; &#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;1- Soma(+)  |  2- Subtra&#231;&#227;o(-)  |  3- Multiplica&#231;&#227;o(X)  |  4- Divis&#227;o(&#247;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;5- Pot&#234;ncia&#231;&#227;o(B&#7497;)  |  6- Raiz quadrada(&#8730;)  |  7- Fatoria(X!)  |  8- Raiz c&#250;bica(&#8731;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;9- Logaritmo(log10)  |  10- Seno(Sen)  |  11- Cosseno(Cos)  |  12- Tangente(Tan) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;13- Arredondamento(&#8776;) | 14- MMC | 15- MDC | 16- Porcentagem(%) &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;17- Convers&#227;o de &#226;ngulos(rad ou &#176;)  |  18- PI(&#960;)  |  19- Euler(e) | 20- Valor absoluto &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot; &#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;Escolha uma op&#231;&#227;o (1-20): &quot;"/>
            <while expression="true">
                <input variable="opcao"/>
                <if expression="opcao = 0">
                    <then>
                        <output expression="&quot;Saindo...&quot;" newline="True"/>
                        <breakpoint expression="" always="True"/>
                    </then>
                    <else>
                        <if expression="opcao = 1">
                            <then/>
                            <else>
                                <if expression="opcao = 2">
                                    <then>
                                        <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
                                        <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
                                        <input variable="num1"/>
                                        <output expression="&quot;Digite outro n&#250;mero: &quot;" newline="True"/>
                                        <input variable="num2"/>
                                        <assign variable="resultado" expression="num1 - num2"/>
                                        <output expression="&quot;A subtra&#231;&#227;o de &quot;&amp; num1 &amp;&quot;-&quot;&amp; num2 &amp;&quot;=&quot;&amp; resultado" newline="True"/>
                                        <output expression="&quot; ------------------------------------------------------------------------------------------------------------ &quot; &#13;&#10;&amp; ToChar(13)  &#13;&#10;&amp; &quot;Escolha uma op&#231;&#227;o (1-20): &quot;" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="opcao = 3">
                                            <then/>
                                            <else>
                                                <if expression="opcao = 4">
                                                    <then>
                                                        <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
                                                        <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
                                                        <input variable="num1"/>
                                                        <output expression="&quot;Digite outro n&#250;mero: &quot;" newline="True"/>
                                                        <input variable="num2"/>
                                                        <assign variable="resultado" expression="num1 / num2"/>
                                                        <output expression="&quot;A divis&#227;o de &quot;&amp; num1 &amp;&quot;&#247;&quot;&amp; num2 &amp;&quot;=&quot;&amp; resultado" newline="True"/>
                                                        <output expression="&quot; ------------------------------------------------------------------------------------------------------------ &quot; &#13;&#10;&amp; ToChar(13)  &#13;&#10;&amp; &quot;Escolha uma op&#231;&#227;o (1-20): &quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="opcao = 5">
                                                            <then>
                                                                <declare name="num1, num2, resultado" type="Integer" array="False" size=""/>
                                                                <output expression="&quot;Digite o valor da base(B): &quot;" newline="True"/>
                                                                <input variable="num1"/>
                                                                <output expression="&quot;Digite o valor do expoente(&#7497;): &quot;" newline="True"/>
                                                                <input variable="num2"/>
                                                                <assign variable="resultado" expression="num1 ^ num2"/>
                                                                <output expression="&quot;A potencia&#231;&#227;o da Base (&quot; &amp; num1 &amp; &quot;) elevado a (&quot; &amp; num2 &amp; &quot;) &#233; igual a: &quot; &amp; resultado" newline="True"/>
                                                                <output expression="&quot; ------------------------------------------------------------------------------------------------------------ &quot; &#13;&#10;&amp; ToChar(13)  &#13;&#10;&amp; &quot;Escolha uma op&#231;&#227;o (1-20): &quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <output expression="&quot;Podi n&#227;o men&quot;" newline="True"/>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <output expression="&quot;Valor incorreto&quot;" newline="True"/>
        </body>
    </function>
    <function name="Soma" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite outro n&#250;mero: &quot;" newline="True"/>
            <input variable="num2"/>
            <assign variable="resultado" expression="num1 + num2"/>
            <output expression="&quot;A soma de &quot; &amp; num1 &amp; &quot; + &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
            <output expression="&quot; ------------------------------------------------------------------------------------------------------------ &quot; &#13;&#10;&amp; ToChar(13)  &#13;&#10;&amp; &quot;Escolha uma op&#231;&#227;o (1-20): &quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
