<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="calculadora_em_flowgorithm"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-05 03:09:45 "/>
        <attribute name="created" value="dXNlcjtERVNLVE9QLUdTNklCQVE7MjAyNi0wOC0yMjsiMDM6MDA6MTUgIjsyNzA5"/>
        <attribute name="edited" value="dXNlcjtERVNLVE9QLUdTNklCQVE7MjAyNi0wOS0wNTsiMDM6MDk6NDUgIjsxODsyODg3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <output expression="&quot;MENU CALCULADORA&quot; &#13;&#10;&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot; &#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;1- Soma(+)  |  2- Subtra&#231;&#227;o(-)  |  3- Multiplica&#231;&#227;o(X)  |  4- Divis&#227;o(&#247;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;5- Pot&#234;ncia&#231;&#227;o(B&#7497;)  |  6- Raiz quadrada(&#8730;)  |  7- Fatoria(X!)  |  8- Raiz c&#250;bica(&#8731;) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;9- Logaritmo(log10)  |  10- Seno(Sen)  |  11- Cosseno(Cos)  |  12- Tangente(Tan) &quot;&#13;&#10;&amp;ToChar(10)&amp;&#13;&#10;&quot;13- Arredondamento(&#8776;) | 14- MMC | 15- MDC | 16- Porcentagem(%) &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;17- Convers&#227;o de &#226;ngulos(rad ou &#176;) | 18- IMC | 19- &#193;rea Geom&#233;trica | 20- Absoluto &quot;&#13;&#10;&amp; ToChar(10)&amp;&#13;&#10;&quot;------------------------------------------------------------------------------------------------------------&quot;" newline="True"/>
            <while expression="true">
                <output expression="&quot;Escolha uma opcao (1-20 ou 0 para sair): &quot;" newline="True"/>
                <input variable="opcao"/>
                <if expression="opcao == 0">
                    <then>
                        <output expression="&quot;Saindo...&quot;" newline="True"/>
                        <breakpoint expression="" always="True"/>
                    </then>
                    <else>
                        <if expression="opcao == 1">
                            <then>
                                <call expression="Soma()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 2">
                            <then>
                                <call expression="Subtracao()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 3">
                            <then>
                                <call expression="Multiplicacao()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 4">
                            <then>
                                <call expression="Divisao()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 5">
                            <then>
                                <call expression="Potenciacao()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 6">
                            <then>
                                <call expression="RaizQuadrada()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 7">
                            <then>
                                <call expression="Fatorial()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 8">
                            <then>
                                <call expression="RaizCubica()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 9">
                            <then>
                                <call expression="Logaritmo()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 10">
                            <then>
                                <call expression="Seno()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 11">
                            <then>
                                <call expression="Cosseno()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 12">
                            <then>
                                <call expression="Tangente()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 13">
                            <then>
                                <call expression="Arredondamento()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 14">
                            <then>
                                <call expression="MMC()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 15">
                            <then>
                                <call expression="MDC()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 16">
                            <then>
                                <call expression="Porcentagem()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 17">
                            <then>
                                <call expression="ConversaoAngulos()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 18">
                            <then>
                                <call expression="IMC()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 19">
                            <then>
                                <call expression="AreaGeometrica()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao == 20">
                            <then>
                                <call expression="ValorAbsoluto()"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="opcao &lt; 0 || opcao &gt; 20">
                            <then>
                                <output expression="&quot;Opcao invalida! Digite entre 0 e 20.&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
    <function name="AreaGeometrica" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op" type="Integer" array="False" size=""/>
            <declare name="base, altura, raio, area" type="Real" array="False" size=""/>
            <output expression="&quot;Escolha a figura (1- Ret&#226;ngulo, 2- Tri&#226;ngulo, 3- C&#237;rculo): &quot;" newline="True"/>
            <input variable="op"/>
            <if expression="op == 1">
                <then>
                    <output expression="&quot;Digite a base: &quot;" newline="True"/>
                    <input variable="base"/>
                    <output expression="&quot;Digite a altura: &quot;" newline="True"/>
                    <input variable="altura"/>
                    <assign variable="area" expression="base * altura"/>
                    <output expression="&quot;A &#225;rea do retangulo e = &quot; &amp; area" newline="True"/>
                </then>
                <else>
                    <if expression="op == 2">
                        <then>
                            <output expression="&quot;Digite a base: &quot;" newline="True"/>
                            <input variable="base"/>
                            <output expression="&quot;Digite a altura: &quot;" newline="True"/>
                            <input variable="altura"/>
                            <assign variable="area" expression="(base * altura) / 2.0"/>
                            <output expression="&quot;A &#225;rea do triangulo e = &quot; &amp; area" newline="True"/>
                        </then>
                        <else>
                            <if expression="op == 3">
                                <then>
                                    <output expression="&quot;Digite o raio: &quot;" newline="True"/>
                                    <input variable="raio"/>
                                    <assign variable="area" expression="3.141592653589793 * (raio ^ 2)"/>
                                    <output expression="&quot;A &#225;rea do circulo e = &quot; &amp; area" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Op&#231;&#227;o de figura invalida!&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
    <function name="Arredondamento" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um numero decimal: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Arredondado para baixo: &quot; &amp; Int(num1)" newline="True"/>
            <output expression="&quot;Arredondado para cima: &quot; &amp; (Int(num1) + 1)" newline="True"/>
        </body>
    </function>
    <function name="ConversaoAngulos" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op" type="Integer" array="False" size=""/>
            <declare name="valor, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite 1 (Rad -&gt; Graus) ou 2 (Graus -&gt; Rad): &quot;" newline="True"/>
            <input variable="op"/>
            <output expression="&quot;Digite o valor: &quot;" newline="True"/>
            <input variable="valor"/>
            <if expression="op == 1">
                <then>
                    <assign variable="resultado" expression="valor * (180.0 / 3.141592653589793)"/>
                    <output expression="valor &amp; &quot; rad = &quot; &amp; ToFixed(resultado, 4) &amp; &quot;&#176;&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="resultado" expression="valor * (3.141592653589793 / 180.0)"/>
                    <output expression="valor &amp; &quot;&#176; = &quot; &amp; ToFixed(resultado, 4) &amp; &quot; rad&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Cosseno" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grau, rad, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o &#226;ngulo em graus: &quot;" newline="True"/>
            <input variable="grau"/>
            <assign variable="rad" expression="grau * (PI / 180)"/>
            <assign variable="resultado" expression="Cos(rad)"/>
            <output expression="&quot;O Cosseno de &quot; &amp; grau &amp; &quot;&#176; = &quot; &amp; ToFixed(resultado, 4)" newline="True"/>
        </body>
    </function>
    <function name="Divisao" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o dividendo( d / n ): &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o divisor(n / d): &quot;" newline="True"/>
            <input variable="num2"/>
            <if expression="num2 == 0">
                <then>
                    <output expression="&quot;Error: A calculadora n&#227;o aceita divis&#227;o por zero!&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="resultado" expression="num1 / num2"/>
                    <output expression="&quot;A divisao de &quot; &amp; num1 &amp; &quot; / &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Fatorial" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, fatorial, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um numero inteiro positivo: &quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero &lt; 0">
                <then>
                    <output expression="&quot;Erro: Fatorial n&#227;o aceita negativos!&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="fatorial" expression="1"/>
                    <for variable="i" start="1" end="numero" direction="inc" step="1">
                        <assign variable="fatorial" expression="fatorial * i"/>
                    </for>
                    <output expression="&quot;O fatorial de &quot; &amp; numero &amp; &quot;! = &quot; &amp; fatorial" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="IMC" type="None" variable="">
        <parameters/>
        <body>
            <declare name="peso, altura, imc" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o seu peso (kg): &quot;" newline="True"/>
            <input variable="peso"/>
            <output expression="&quot;Digite a sua altura (m): &quot;" newline="True"/>
            <input variable="altura"/>
            <if expression="altura &lt;= 0">
                <then>
                    <output expression="&quot;Erro: Sua altura deve ser maior que zero!&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="imc" expression="peso / (altura ^ 2)"/>
                    <output expression="&quot;O IMC e = &quot; &amp; ToFixed(imc, 2)" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Logaritmo" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um numero maior que zero: &quot;" newline="True"/>
            <input variable="num1"/>
            <if expression="num1 &lt;= 0">
                <then>
                    <output expression="&quot;Error: Logaritmo exige valor maior que zero!&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="resultado" expression="Log10(num1)"/>
                    <output expression="&quot;O Log10 de &quot; &amp; num1 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="MDC" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor1, valor2, copvalor1, copvalor2, temp" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o primeiro valor: &quot;" newline="True"/>
            <input variable="valor1"/>
            <output expression="&quot;Digite o segundo valor: &quot;" newline="True"/>
            <input variable="valor2"/>
            <assign variable="copvalor1" expression="valor1"/>
            <assign variable="copvalor2" expression="valor2"/>
            <while expression="copvalor2 != 0">
                <assign variable="temp" expression="copvalor2"/>
                <assign variable="copvalor2" expression="copvalor1 % copvalor2"/>
                <assign variable="copvalor1" expression="temp"/>
            </while>
            <output expression="&quot;O MDC de &quot; &amp; valor1 &amp; &quot; e &quot; &amp; valor2 &amp; &quot; = &quot; &amp; copvalor1" newline="True"/>
        </body>
    </function>
    <function name="MMC" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor1, valor2, copvalor1, copvalor2, temp, mdc, mmc" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o primeiro valor: &quot;" newline="True"/>
            <input variable="valor1"/>
            <output expression="&quot;Digite o segundo valor: &quot;" newline="True"/>
            <input variable="valor2"/>
            <assign variable="copvalor1" expression="valor1"/>
            <assign variable="copvalor2" expression="valor2"/>
            <while expression="copvalor2 != 0">
                <assign variable="temp" expression="copvalor2"/>
                <assign variable="copvalor2" expression="copvalor1 % copvalor2"/>
                <assign variable="copvalor1" expression="temp"/>
            </while>
            <assign variable="mdc" expression="copvalor1"/>
            <assign variable="mmc" expression="(valor1 * valor2) / mdc"/>
            <output expression="&quot;O MMC de &quot; &amp; valor1 &amp; &quot; e &quot; &amp; valor2 &amp; &quot; = &quot; &amp; mmc" newline="True"/>
        </body>
    </function>
    <function name="Multiplicacao" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
            <input variable="num2"/>
            <assign variable="resultado" expression="num1 * num2"/>
            <output expression="&quot;A multiplicacao de &quot; &amp; num1 &amp; &quot; X &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="Porcentagem" type="None" variable="">
        <parameters/>
        <body>
            <declare name="porcentagem, total, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a porcentagem (%): &quot;" newline="True"/>
            <input variable="porcentagem"/>
            <output expression="&quot;Digite o valor total: &quot;" newline="True"/>
            <input variable="total"/>
            <assign variable="resultado" expression="(porcentagem / 100.0) * total"/>
            <output expression="porcentagem &amp; &quot;% de &quot; &amp; total &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="Potenciacao" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor da base(B): &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o valor do expoente(&#7497;): &quot;" newline="True"/>
            <input variable="num2"/>
            <assign variable="resultado" expression="num1 ^ num2"/>
            <output expression="&quot;A potencia&#231;&#227;o de &quot; &amp; num1 &amp; &quot; ^ &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="RaizCubica" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <assign variable="resultado" expression="num1 ^ (1.0 / 3.0)"/>
            <output expression="&quot;A raiz cubica de &quot; &amp; num1 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="RaizQuadrada" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <if expression="num1 &lt; 0">
                <then>
                    <output expression="&quot;Error: Raiz de n&#250;meros negativos n&#227;o e aceito nos reais&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="resultado" expression="Sqrt(num1)"/>
                    <output expression="&quot;A raiz quadrada de &quot; &amp; num1 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Seno" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grau, rad, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o &#226;ngulo em graus: &quot;" newline="True"/>
            <input variable="grau"/>
            <assign variable="rad" expression="grau * (3.141592653589793 / 180.0)"/>
            <assign variable="resultado" expression="Sin(rad)"/>
            <output expression="&quot;O Seno de &quot; &amp; grau &amp; &quot;&#176; = &quot; &amp; ToFixed(resultado, 4)" newline="True"/>
        </body>
    </function>
    <function name="Soma" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
            <input variable="num2"/>
            <assign variable="resultado" expression="num1 + num2"/>
            <output expression="&quot;A soma de &quot; &amp; num1 &amp; &quot; + &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="Subtracao" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
            <input variable="num2"/>
            <assign variable="resultado" expression="num1 - num2"/>
            <output expression="&quot;A subtracao de &quot; &amp; num1 &amp; &quot; - &quot; &amp; num2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
    <function name="Tangente" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grau, rad, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o angulo em graus: &quot;" newline="True"/>
            <input variable="grau"/>
            <assign variable="rad" expression="grau * (3.141592653589793 / 180.0)"/>
            <assign variable="resultado" expression="Tan(rad)"/>
            <output expression="&quot;A Tangente de &quot; &amp; grau &amp; &quot;&#176; = &quot; &amp; ToFixed(resultado, 4)" newline="True"/>
        </body>
    </function>
    <function name="ValorAbsoluto" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um numero: &quot;" newline="True"/>
            <input variable="num1"/>
            <assign variable="resultado" expression="Abs(num1)"/>
            <output expression="&quot;O valor absoluto de &quot; &amp; num1 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
</flowgorithm>
